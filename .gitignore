__pycache__/
*.pyc
.venv/
.venv-airflow/
venv/
*.egg-info/
.DS_Store

# MLflow local tracking store — regenerated by re-running training
# (src/models/train_baseline.py is deterministic). A shared/production
# setup would point MLFLOW_TRACKING_URI at a real tracking server with a
# shared backend store instead of a local sqlite file; out of scope for
# the MVP (see progress.md Phase 2 notes).
mlflow.db
mlruns/
mlartifacts/

# Airflow generated state — metadata DB, logs, plugins cache. The DAG
# source itself lives in airflow/dags/ (tracked), not here; AIRFLOW_HOME
# is pointed at this directory (see progress.md Phase 3 notes).
airflow_home/

# Pipeline intermediate/ephemeral state — regenerated by running the
# pipeline (src/pipeline/ingest.py etc.), not meaningful to version:
data/staging/
# mlflow run_id from whichever run happened last, not stable
data/processed/phase3_run_info.json
# confirmed byte-identical to phase1_metrics.json (already tracked); see progress.md
data/processed/phase3_metrics.json
# confirmed byte-identical to models/baseline_model.joblib (already DVC-tracked); see progress.md
models/phase3_model.joblib
